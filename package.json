{
  "name": "adventurers-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "balance": "node --import tsx scripts/balance.ts",
    "test:browser": "node --import tsx scripts/browser.mjs",
    "test:mobile": "node --import tsx scripts/mobile.mjs",
    "test:theme": "node --import tsx scripts/theme.mjs",
    "check": "npm test && npm run build",
    "test:smoke": "node --import tsx scripts/mobile.mjs --quick",
    "test:language": "node --import tsx scripts/language.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
